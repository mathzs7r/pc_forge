# Copie este arquivo para ".env" (dentro da pasta backend) e ajuste os valores:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# DB_PASSWORD tem que ser a senha do SEU MySQL (a mesma que você usa no
# Database Client do VS Code). O "escola" abaixo é só um exemplo.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escola
DB_NAME=pc_forge
PORT=3000

# Segredo que assina o token de login (carrinho e perfil exigem esse token).
# Use um texto longo e aleatório (mínimo 16 caracteres) e NÃO compartilhe.
# Pra gerar um:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem isso a API usa um segredo temporário e todo mundo precisa entrar de novo
# a cada reinício dela.
AUTH_SECRET=PcForgeSecret16x123213
