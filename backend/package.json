{
  "name": "pc_forge-backend",
  "version": "1.0.0",
  "description": "API do PC Forge: clientes compram peças de TI, lojas vendem. Login/cadastro de cliente, loja e admin.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node migration.js && node server.js",
    "start:api": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migration.js",
    "migrate:seed": "node migration.js --seed",
    "migrate:catalogo": "node migration.js && node seed-fotos-catalogo.js",
    "seed:fotos": "node seed-fotos-catalogo.js",
    "seed:reais": "node seed-fotos-reais.js",
    "gerar:catalogo": "node gerar-catalogo.js",
    "hash": "node gerar-hash.js",
    "seed:demo": "node seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
